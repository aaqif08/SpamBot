# ============================================================================
# BotShield AI — PRODUCTION configuration template. Copy to .env on the server.
# Never commit the real file. Every value marked REQUIRED must be set.
# ============================================================================
BOTSHIELD_ENVIRONMENT=production
BOTSHIELD_LOG_LEVEL=INFO
BOTSHIELD_LOG_JSON=true

# REQUIRED — PostgreSQL
BOTSHIELD_DATABASE_URL=postgresql+psycopg://botshield:CHANGE_ME@db:5432/botshield
# Optional: dedicated PostgreSQL schema when the database is shared with other applications
# BOTSHIELD_DB_SCHEMA=botshield
BOTSHIELD_DB_POOL_SIZE=5
BOTSHIELD_DB_MAX_OVERFLOW=10

# REQUIRED — JWT signing key (python -c "import secrets; print(secrets.token_urlsafe(48))")
BOTSHIELD_SECRET_KEY=CHANGE_ME
BOTSHIELD_ACCESS_TOKEN_MINUTES=30
BOTSHIELD_REFRESH_TOKEN_DAYS=7
BOTSHIELD_COOKIE_SECURE=true
# strict = SPA and API on the same site (recommended); none = different domains (cross-site cookie, needs COOKIE_SECURE=true)
BOTSHIELD_COOKIE_SAMESITE=strict
# BOTSHIELD_COOKIE_DOMAIN=app.example.com

# REQUIRED — exact browser origins of the frontend (comma-separated, no trailing slash)
BOTSHIELD_CORS_ORIGINS=https://app.example.com
# Reverse proxy in front of the API (Caddy/nginx/Traefik/Render): enable X-Forwarded-* handling
BOTSHIELD_TRUSTED_PROXIES=*
BOTSHIELD_DOCS_ENABLED=false
BOTSHIELD_RATE_LIMIT_PER_MINUTE=120
BOTSHIELD_ML_RATE_LIMIT_PER_MINUTE=30
BOTSHIELD_MAX_UPLOAD_MB=50

# Storage: object storage recommended; local requires a persistent volume mounted at the root below
BOTSHIELD_STORAGE_BACKEND=s3
BOTSHIELD_S3_BUCKET=botshield-prod
BOTSHIELD_S3_ENDPOINT_URL=
BOTSHIELD_S3_REGION=eu-west-1
BOTSHIELD_S3_ACCESS_KEY_ID=CHANGE_ME
BOTSHIELD_S3_SECRET_ACCESS_KEY=CHANGE_ME
BOTSHIELD_S3_PREFIX=botshield
# BOTSHIELD_STORAGE_BACKEND=local
# BOTSHIELD_STORAGE_LOCAL_ROOT=/app/data/storage

# Background jobs: Celery + Redis with the worker service (docker-compose.prod.yml); "thread" only for single-container installs
BOTSHIELD_JOB_BACKEND=celery
BOTSHIELD_REDIS_URL=redis://redis:6379/0
BOTSHIELD_CELERY_TASK_TIME_LIMIT_SECONDS=3600

# Optional integrations
# BOTSHIELD_X_BEARER_TOKEN=

# Initial administrator (used once by: python -m app.cli create-admin); remove afterwards
# BOTSHIELD_ADMIN_EMAIL=admin@example.com
# BOTSHIELD_ADMIN_PASSWORD=CHANGE_ME_STRONG
# BOTSHIELD_ADMIN_ORG=Example Ltd

# PostgreSQL container (docker-compose.prod.yml)
POSTGRES_USER=botshield
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=botshield
