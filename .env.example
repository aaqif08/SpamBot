# ============================================================================
# BotShield AI — backend configuration (development profile)
# Copy to .env for local development. Production: see .env.production.example
# Frontend: only VITE_API_BASE_URL is read by the browser build (frontend/.env.example)
# ============================================================================

# --- runtime ---------------------------------------------------------------
BOTSHIELD_ENVIRONMENT=development          # development | staging | production | test
BOTSHIELD_LOG_LEVEL=INFO
# BOTSHIELD_LOG_JSON=false                 # default: JSON in staging/production

# --- database --------------------------------------------------------------
# SQLite is allowed only in development/test. Staging/production require PostgreSQL.
BOTSHIELD_DATABASE_URL=sqlite:///./backend/data/botshield.db
# BOTSHIELD_DATABASE_URL=postgresql+psycopg://botshield:botshield@localhost:5432/botshield

# --- authentication --------------------------------------------------------
# Required in staging/production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# BOTSHIELD_SECRET_KEY=
BOTSHIELD_ACCESS_TOKEN_MINUTES=30
BOTSHIELD_REFRESH_TOKEN_DAYS=7
BOTSHIELD_PASSWORD_MIN_LENGTH=10
BOTSHIELD_LOGIN_RATE_LIMIT_PER_MINUTE=10
BOTSHIELD_LOGIN_LOCKOUT_THRESHOLD=8
BOTSHIELD_LOGIN_LOCKOUT_MINUTES=15
# BOTSHIELD_COOKIE_SECURE=false            # default: true in staging/production (HTTPS)
# BOTSHIELD_COOKIE_DOMAIN=
# BOTSHIELD_COOKIE_SAMESITE=strict          # strict | lax | none (none requires COOKIE_SECURE=true; for cross-domain SPA + API)

# --- http ------------------------------------------------------------------
BOTSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# BOTSHIELD_TRUSTED_PROXIES=               # e.g. 10.0.0.0/8 or * behind a reverse proxy (enables X-Forwarded-*)
BOTSHIELD_MAX_REQUEST_BODY_MB=60
BOTSHIELD_MAX_UPLOAD_MB=50
BOTSHIELD_MAX_BATCH_ROWS=50000
BOTSHIELD_RATE_LIMIT_PER_MINUTE=120
BOTSHIELD_ML_RATE_LIMIT_PER_MINUTE=30
# BOTSHIELD_DOCS_ENABLED=true              # default: disabled in production

# --- storage ---------------------------------------------------------------
BOTSHIELD_STORAGE_BACKEND=local            # local | s3
BOTSHIELD_STORAGE_LOCAL_ROOT=./backend/data/storage
# BOTSHIELD_S3_BUCKET=
# BOTSHIELD_S3_ENDPOINT_URL=               # S3-compatible endpoint (MinIO, R2, …); empty for AWS
# BOTSHIELD_S3_REGION=
# BOTSHIELD_S3_ACCESS_KEY_ID=
# BOTSHIELD_S3_SECRET_ACCESS_KEY=
# BOTSHIELD_S3_PREFIX=botshield

# --- background jobs -------------------------------------------------------
BOTSHIELD_JOB_BACKEND=thread               # thread (single node) | celery (requires Redis + worker)
# BOTSHIELD_REDIS_URL=redis://localhost:6379/0

# --- ML --------------------------------------------------------------------
BOTSHIELD_MAX_TWEETS_PER_USER=100          # tweets per account used for text features (benchmark import)
BOTSHIELD_EXPLANATION_LIME_SAMPLES=3000

# --- X (Twitter) API v2 provider ------------------------------------------
# App-only bearer token from developer.x.com. Reading other users' tweets needs the Basic tier or higher.
# BOTSHIELD_X_BEARER_TOKEN=
# BOTSHIELD_X_MAX_TWEETS=100
# BOTSHIELD_X_TIMEOUT_SECONDS=15
# BOTSHIELD_X_CACHE_TTL_SECONDS=600

# --- retention (optional) --------------------------------------------------
# BOTSHIELD_RETENTION_PREDICTIONS_DAYS=
# BOTSHIELD_RETENTION_AUDIT_DAYS=
