# BotShield AI — backend configuration (copy to .env). All variables are optional.
# Prefix: BOTSHIELD_

# Runtime
BOTSHIELD_ENVIRONMENT=production
BOTSHIELD_LOG_LEVEL=INFO

# Storage (defaults resolve inside backend/)
# BOTSHIELD_DATABASE_URL=sqlite:///./backend/data/botshield.db
# BOTSHIELD_DATA_DIR=./backend/data
# BOTSHIELD_MODELS_DIR=./backend/models

# HTTP
BOTSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BOTSHIELD_MAX_UPLOAD_MB=50
BOTSHIELD_MAX_BATCH_ROWS=50000
BOTSHIELD_RATE_LIMIT_PER_MINUTE=120

# Demo mode (synthetic data generator) — DEMO DATA IS NOT REAL SOCIAL MEDIA DATA
BOTSHIELD_DEMO_MODE_ENABLED=false

# Cresci import: tweets per account used for text-derived features
BOTSHIELD_MAX_TWEETS_PER_USER=100

# X (Twitter) API v2 adapter — live account fetch on the Analyze page.
# 1. developer.x.com → Developer Portal → your Project/App → "Keys and tokens" → Bearer Token (app-only).
# 2. Paste it below and restart the backend. Never commit a real token.
# Access level: profile lookup works on every tier; reading another user's tweets needs Basic or higher.
BOTSHIELD_X_BEARER_TOKEN=
# BOTSHIELD_X_API_BASE_URL=https://api.x.com/2
# BOTSHIELD_X_MAX_TWEETS=100
# BOTSHIELD_X_TIMEOUT_SECONDS=15
# BOTSHIELD_X_CACHE_TTL_SECONDS=600
